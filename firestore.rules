rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. GLOBAL AUTHENTICATION & ROLE HELPERS ──────────────────────────────
    function isAuth() { 
      return request.auth != null; 
    }
    function isAdmin() { 
      return isAuth() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'admin@mykalakar.com'
      ); 
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── 2. METADATA, CATEGORIES & MASTER DATA (PUBLIC READ, AUTH WRITE) ──────
    match /events/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      match /{document=**} { allow read: if true; allow write: if isAuth(); }
    }
    
    match /eventBriefs/{id} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      match /{document=**} { allow read: if true; allow write: if isAuth(); }
    }

    match /event_briefs/{id} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      match /{document=**} { allow read: if true; allow write: if isAuth(); }
    }

    match /event_applications/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }
    
    match /states/{id} { allow read: if true; allow write: if isAuth(); }
    match /categories/{id} { allow read: if true; allow write: if true; }
    match /category_groups/{id} { allow read: if true; allow write: if isAuth(); }
    match /event_category_mappings/{id} { allow read: if true; allow write: if isAuth(); }
    match /legacy_categories/{id} { allow read: if true; allow write: if isAuth(); }
    match /master_data/{version} {
      allow read: if true;
      allow write: if isAuth();
      match /{document=**} { allow read: if true; allow write: if isAuth(); }
    }

    // ── 3. ARTISTS REGISTRY & PUBLIC PROFILE ─────────────────────────────────
    match /artists/{id} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAuth();
      match /{document=**} {
        allow read: if true;
        allow write: if isAuth();
      }
    }

    // ── 3.5 PRIVATE ARTIST INFORMATION ──────────────────────────────────────
    match /artistPrivate/{uid} {
      allow read, write: if isAuth() && (isOwner(uid) || isAdmin());
    }

    // ── 4. IDENTITY CORE (USERS & PRIVILEGED ADMINS) ─────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if isAuth();
      match /{document=**} {
        allow read: if true;
        allow write: if isAuth();
      }
    }

    match /admins/{uid} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── 5. ADVANCED TRANSACTION ENGINE (APPLICATIONS, BOOKINGS, REVIEWS) ─────
    match /artist_applications/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuth();
    }

    match /bookings/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    match /artist_bookings/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    match /booking_reservations/{id} {
      allow read, write: if isAuth();
    }

    match /artist_availability/{id} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /inquiries/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuth();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /notifications/{id} {
      allow read, write: if isAuth();
    }

    match /admin_requests/{id} {
      allow read, write: if isAuth();
    }

    match /admin_audit_logs/{id} {
      allow read, write: if isAuth();
    }

    match /notification_logs/{id} {
      allow read, write: if isAuth();
    }

    match /telecaller_leads/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuth();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAuth();
      match /{document=**} {
        allow read: if true;
        allow write: if isAuth();
      }
    }
  }
}
