rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Verify user is signed in
    function signedIn() {
      return request.auth != null;
    }

    // Helper: Validate acceptable media formats including images and PDFs
    function isValidMedia() {
      return request.resource == null ||
             request.resource.contentType == null ||
             request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf');
    }

    // Helper: Ensure file sizes do not exceed 25MB limits
    function isValidSize() {
      return request.resource == null || request.resource.size <= 25 * 1024 * 1024;
    }

    // ── ARTIST PROFILE ASSETS PATHS ───────────────────
    match /artists/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isValidMedia() && isValidSize();
    }

    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isValidMedia() && isValidSize();
    }

    match /covers/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isValidMedia() && isValidSize();
    }

    match /galleries/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isValidMedia() && isValidSize();
    }

    match /private-documents/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && isValidSize();
    }

    // ── GLOBAL USER PROFILE PATHS ────────────────────────────────────────────
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isValidMedia() && isValidSize();
    }

    // ── GENERAL PUBLIC / ADMIN CONTENT (Events, Categories, Banners, etc.) ─────
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ── CATCH-ALL FOR ALL SIGNED-IN USERS ────────────────────────────────────
    match /{allFiles=**} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}


